PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/calorietrack_db?sslmode=disable
JWT_SECRET=replace_with_a_random_secret_at_least_16_characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id.apps.googleusercontent.com
TRUST_PROXY=false
# COOKIE_SAME_SITE=none # Use 'none' for cross-domain production (e.g. Vercel frontend + Render backend)
